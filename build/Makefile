####### Compile

main.o: ../src/main.cpp ../src/backend.h \
		../src/systemtheme.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../src/main.cpp

backend.o: ../src/backend.cpp ../src/backend.h \
		../src/markdownhighlighter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o backend.o ../src/backend.cpp

markdownhighlighter.o: ../src/markdownhighlighter.cpp ../src/markdownhighlighter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o markdownhighlighter.o ../src/markdownhighlighter.cpp

systemtheme.o: ../src/systemtheme.cpp ../src/systemtheme.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o systemtheme.o ../src/systemtheme.cpp

qrc_resources.o: qrc_resources.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_resources.o qrc_resources.cpp

moc_backend.o: moc_backend.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_backend.o moc_backend.cpp

moc_markdownhighlighter.o: moc_markdownhighlighter.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_markdownhighlighter.o moc_markdownhighlighter.cpp

moc_systemtheme.o: moc_systemtheme.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_systemtheme.o moc_systemtheme.cpp

